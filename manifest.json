{
  "manifest_version": 3,
  "name": "知乎去侧栏",
  "version": "2.7.0",
  "description": "隐藏知乎非首页右侧栏，主内容区居中，支持拖拽调整宽度，SPA 路由感知，专栏主页居中",
  "permissions": [],
  "host_permissions": [
    "https://www.zhihu.com/*",
    "https://zhuanlan.zhihu.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
